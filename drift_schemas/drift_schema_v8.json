  "fixed_sql": [
    {
      "name": "patients",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"patients\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"initials\" TEXT NOT NULL, \"age\" INTEGER NOT NULL, \"condition_summary\" TEXT NOT NULL, \"dialysis_center\" TEXT NOT NULL, \"dry_weight_kg\" REAL NOT NULL, \"dry_weight_delta_kg\" REAL NOT NULL DEFAULT 0.0, \"schedule_json\" TEXT NOT NULL DEFAULT '{}', \"blood_group\" TEXT NOT NULL DEFAULT '', \"allergies\" TEXT NOT NULL DEFAULT '', \"emergency_contact\" TEXT NOT NULL DEFAULT '', \"comorbidities\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "documents",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"documents\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"hospital\" TEXT NOT NULL DEFAULT '', \"doctor\" TEXT NOT NULL DEFAULT '', \"document_date\" INTEGER NOT NULL, \"captured_at\" INTEGER NOT NULL, \"original_path\" TEXT NOT NULL DEFAULT '', \"preview_path\" TEXT NOT NULL DEFAULT '', \"ocr_text\" TEXT NOT NULL DEFAULT '', \"tags_json\" TEXT NOT NULL DEFAULT '[]', \"note\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "document_pages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"document_pages\" (\"id\" TEXT NOT NULL, \"document_id\" TEXT NOT NULL, \"page_index\" INTEGER NOT NULL, \"original_path\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "medications",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"medications\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"dose\" TEXT NOT NULL, \"frequency_code\" TEXT NOT NULL, \"purpose\" TEXT NOT NULL, \"doctor\" TEXT NOT NULL DEFAULT '', \"schedule_group\" TEXT NOT NULL, \"timing_cues_json\" TEXT NOT NULL DEFAULT '[]', \"schedule_note\" TEXT NOT NULL DEFAULT '', \"start_date\" INTEGER NOT NULL, \"end_date\" INTEGER NULL, \"change_note\" TEXT NOT NULL DEFAULT '', \"change_date\" INTEGER NULL, \"source_document_id\" TEXT NULL, \"interval_days\" INTEGER NULL, \"last_given_on\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "lab_results",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lab_results\" (\"id\" TEXT NOT NULL, \"metric_code\" TEXT NOT NULL, \"value\" REAL NOT NULL, \"taken_at\" INTEGER NOT NULL, \"document_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "timeline_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"timeline_events\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"subtitle\" TEXT NOT NULL DEFAULT '', \"occurred_at\" INTEGER NOT NULL, \"document_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "doses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"doses\" (\"id\" TEXT NOT NULL, \"medication_id\" TEXT NOT NULL, \"medication_label\" TEXT NOT NULL, \"time_label\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, \"scheduled_on\" INTEGER NOT NULL, \"taken\" INTEGER NOT NULL DEFAULT 0 CHECK (\"taken\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "chat_messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chat_messages\" (\"id\" TEXT NOT NULL, \"role\" TEXT NOT NULL, \"content\" TEXT NOT NULL, \"citations_json\" TEXT NOT NULL DEFAULT '[]', \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "dialysis_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"dialysis_sessions\" (\"id\" TEXT NOT NULL, \"scheduled_at\" INTEGER NOT NULL, \"completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"completed\" IN (0, 1)), \"center\" TEXT NOT NULL DEFAULT '', \"ultrafiltration_l\" REAL NULL, \"pre_weight_kg\" REAL NULL, \"post_weight_kg\" REAL NULL, \"duration_hours\" REAL NULL, \"note\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "insurance_policies",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"insurance_policies\" (\"id\" TEXT NOT NULL, \"insurer_name\" TEXT NOT NULL, \"policy_number\" TEXT NOT NULL, \"tpa_name\" TEXT NOT NULL DEFAULT '', \"claim_window_days\" INTEGER NOT NULL DEFAULT 30, \"note\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "claims",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"claims\" (\"id\" TEXT NOT NULL, \"policy_id\" TEXT NULL, \"title\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"submitted_on\" INTEGER NULL, \"settled_on\" INTEGER NULL, \"claimed_amount_paise\" INTEGER NULL, \"approved_amount_paise\" INTEGER NULL, \"insurer_ref\" TEXT NOT NULL DEFAULT '', \"note\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
